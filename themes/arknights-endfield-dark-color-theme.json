  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6F6F7C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#55D98A"
      }
    },
    {
      "name": "String escape / interpolation punctuation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#FF5C8A"
      }
    },
    {
      "name": "Regexp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#3DCBEA"
      }
    },
    {
      "name": "Numeric literal",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FF5C8A"
      }
    },
    {
      "name": "Boolean / null / undefined",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.nan"
      ],
      "settings": {
        "foreground": "#5C93FF",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Other language constants",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#5C93FF"
      }
    },
    {
      "name": "Keyword — control flow",
      "scope": [
        "keyword.control",
        "keyword.operator.new",
        "keyword.other.using"
      ],
      "settings": {
        "foreground": "#F5E642",
        "fontStyle": ""
      }
    },
    {
      "name": "Keyword — other",
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#F5E642"
      }
    },
    {
      "name": "Keyword operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#A8A8B4",
        "fontStyle": ""
      }
    },
    {
      "name": "Storage type / modifier",
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#5C93FF",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Arrow function =>",
      "scope": [
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#5C93FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Type / class name",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#FF5C8A"
      }
    },
    {
      "name": "Inherited class",
      "scope": [
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#33CFFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Interface",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#33CFFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Generic / type parameter",
      "scope": [
        "entity.name.type.parameter",
        "punctuation.definition.typeparameters"
      ],
      "settings": {
        "foreground": "#33CFFF"
      }
    },
    {
      "name": "Function / method name",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#B58CFF"
      }
    },
    {
      "name": "Function parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#4DBDF0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#DADAD6"
      }
    },
    {
      "name": "Variable — language (this, self, super)",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#4DBDF0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable — property / member access",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable"
      ],
      "settings": {
        "foreground": "#D9CE45"
      }
    },
    {
      "name": "Variable — constant",
      "scope": [
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#F0838B"
      }
    },
    {
      "name": "Punctuation — separators, terminators",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.parameters"
      ],
      "settings": {
        "foreground": "#8A8A96"
      }
    },
    {
      "name": "Punctuation — brackets / braces / parens",
      "scope": [
        "punctuation.definition.block",
        "punctuation.section",
        "meta.brace.round",
        "meta.brace.square",
        "meta.brace.curly"
      ],
      "settings": {
        "foreground": "#B4B4BE"
      }
    },
    {
      "name": "Tag name",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E0A0A0",
        "fontStyle": ""
      }
    },
    {
      "name": "Tag attribute name",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FF5C8A"
      }
    },
    {
