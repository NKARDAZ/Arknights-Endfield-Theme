  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#3DB8E8"
    },
    "class": {
      "foreground": "#33CFFF"
    },
    "class.declaration": {
      "foreground": "#33CFFF"
    },
    "interface": {
      "foreground": "#33CFFF"
    },
    "enum": {
      "foreground": "#33CFFF"
    },
    "enumMember": {
      "foreground": "#FF5C8A"
    },
    "struct": {
      "foreground": "#33CFFF"
    },
    "typeParameter": {
      "foreground": "#33CFFF",
      "italic": true
    },
    "function": {
      "foreground": "#B58CFF"
