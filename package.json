{
  "name": "arknights-endfield-theme",
  "displayName": "Arknights: Endfield Theme",
  "description": "A fan-made theme inspired by Arknights: Endfield. Not affiliated with or endorsed by Hypergryph.",
  "publisher": "YallaNkardaz",
  "version": "1.0.5",
  "scripts": {
    "build": "node scripts/build-themes.js",
    "watch": "node scripts/watch-themes.js",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "chokidar": "^6.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Arknights: Endfield [Light Cold]",
        "uiTheme": "vs",
        "path": "./themes/arknights-endfield-cold-light-color-theme.json"
      },
      {
        "label": "Arknights: Endfield [Light Warm]",
        "uiTheme": "vs",
        "path": "./themes/arknights-endfield-warm-light-color-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NKARDAZ/Arknights-Endfield-Theme.git"
  },
  "icon": "logo.png"
}
